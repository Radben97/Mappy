<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 1. Background View of a Map -->
    <FrameLayout
        android:id="@+id/map_background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_map_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/current_map_location"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_map_background" />

        <!-- Location Info Card Overlay on Map -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp"
            android:background="@drawable/bg_location_card"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_green_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/current_map_location"
                android:textColor="#37474F"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 2. Opaque Header with application name "mappy" on top left with sufficient padding -->
    <FrameLayout
        android:id="@+id/opaque_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="18dp"
            android:text="@string/app_name_mappy"
            android:textColor="#1E88E5"
            android:textSize="28sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 3. "Use map" button at the bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <Button
            android:id="@+id/btn_use_map"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_use_map_button"
            android:elevation="8dp"
            android:text="@string/use_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
